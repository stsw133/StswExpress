<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:se="clr-namespace:StswExpress">

    <Style TargetType="{x:Type se:StswLineChartItem}">
        <Setter Property="Background" Value="{Binding Title, RelativeSource={RelativeSource Self}, Converter={x:Static se:StswColorConverter.Instance}, ConverterParameter='G B?20%'}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswLineChartItem}">
                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type se:StswLineChart}}}"
                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type se:StswLineChart}}}">
                        <Canvas>
                            <Line X1="{Binding PreviousPosition.X, RelativeSource={RelativeSource TemplatedParent}}"
                                  Y1="{Binding PreviousPosition.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                  X2="{Binding Position.X, RelativeSource={RelativeSource TemplatedParent}}"
                                  Y2="{Binding Position.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Background}"
                                  StrokeThickness="{Binding LineThickness, RelativeSource={RelativeSource AncestorType={x:Type se:StswLineChart}}}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.8"
                                  Visibility="{Binding ShowConnector, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static se:StswBoolConverter.Instance}}"/>
                            <Border Background="{TemplateBinding Background}"
                                    Width="{Binding PointSize, RelativeSource={RelativeSource AncestorType={x:Type se:StswLineChart}}}"
                                    Height="{Binding PointSize, RelativeSource={RelativeSource AncestorType={x:Type se:StswLineChart}}}"
                                    CornerRadius="500"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource StswChart.Static.Border}"
                                    Canvas.Left="{Binding DotPosition.X, RelativeSource={RelativeSource TemplatedParent}}"
                                    Canvas.Top="{Binding DotPosition.Y, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.ToolTip>
                                    <se:StswChartTip ShowDescription="True" ShowName="True"/>
                                </Border.ToolTip>
                            </Border>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>