<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
                    xmlns:se="clr-namespace:StswExpress">

    <Style TargetType="{x:Type se:StswTimeline}">
        <Setter Property="Background" Value="{DynamicResource StswTimeline.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StswTimeline.Static.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource StswTimeline.Indicator.Fill}"/>
        <Setter Property="LineBrush" Value="{DynamicResource StswTimeline.Static.Border}"/>
        <Setter Property="LineThickness" Value="2"/>
        <Setter Property="IndicatorSize" Value="12"/>
        <Setter Property="ItemHeight" Value="80"/>
        <Setter Property="Padding" Value="24 32"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="False"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswTimeline}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Border Height="{TemplateBinding LineThickness}"
                                    Background="{TemplateBinding LineBrush}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"
                                    CornerRadius="1"/>
                            <Canvas x:Name="PART_ItemsHost"
                                    Margin="{TemplateBinding Padding}"
                                    ClipToBounds="False"
                                    IsItemsHost="True"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type se:StswTimelineItem}">
        <Setter Property="Foreground" Value="{DynamicResource StswTimeline.Indicator.Fill}"/>
        <Setter Property="Height" Value="{Binding ItemHeight, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimeline}}}"/>
        <Setter Property="IndicatorSize" Value="{Binding IndicatorSize, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimeline}}}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="ToolTipService.ToolTip">
            <Setter.Value>
                <se:StswToolTip MaxWidth="260" Placement="Top">
                    <StackPanel>
                        <se:StswText Text="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimelineItem}}}"
                                     FontWeight="SemiBold"
                                     Visibility="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimelineItem}}, Converter={x:Static se:StswExistenceConverter.Instance}, ConverterParameter='!null'}"/>
                        <se:StswText Text="{Binding Date, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimelineItem}}, StringFormat={}{0:G}}"
                                     FontSize="12"
                                     Foreground="{DynamicResource StswTimeline.Static.Border}"
                                     Visibility="{Binding Date, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimelineItem}}, Converter={x:Static se:StswExistenceConverter.Instance}, ConverterParameter='!null'}"/>
                        <se:StswText Text="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimelineItem}}}"
                                     Margin="0,4,0,0"
                                     TextWrapping="Wrap"
                                     Visibility="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimelineItem}}, Converter={x:Static se:StswExistenceConverter.Instance}, ConverterParameter='!null'}"/>
                        <ContentPresenter Content="{Binding ToolTipContent, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimelineItem}}}"
                                          Margin="0,4,0,0"
                                          Visibility="{Binding ToolTipContent, RelativeSource={RelativeSource AncestorType={x:Type se:StswTimelineItem}}, Converter={x:Static se:StswExistenceConverter.Instance}, ConverterParameter='!null'}"/>
                    </StackPanel>
                </se:StswToolTip>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswTimelineItem}">
                    <Grid Height="{TemplateBinding Height}" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <se:StswText Text="{TemplateBinding Header}"
                                         FontWeight="SemiBold"
                                         TextAlignment="Center"
                                         Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static se:StswExistenceConverter.Instance}, ConverterParameter='!null'}"/>
                            <se:StswText Text="{Binding Date, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:dd MMM yyyy}}"
                                         FontSize="12"
                                         Foreground="{DynamicResource StswTimeline.Static.Border}"
                                         TextAlignment="Center"
                                         Visibility="{Binding Date, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static se:StswExistenceConverter.Instance}, ConverterParameter='!null'}"/>
                        </StackPanel>
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Ellipse x:Name="PART_Marker"
                                     Width="{TemplateBinding IndicatorSize}"
                                     Height="{TemplateBinding IndicatorSize}"
                                     Fill="{TemplateBinding Foreground}"
                                     Stroke="{DynamicResource StswTimeline.Static.Border}"
                                     StrokeThickness="1"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PART_MarkerScale"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_MarkerScale" Property="ScaleTransform.ScaleX" Value="1.2"/>
                            <Setter TargetName="PART_MarkerScale" Property="ScaleTransform.ScaleY" Value="1.2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>