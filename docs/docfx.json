{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "StswExpress.Commons/StswExpress.Commons.csproj",
            "StswExpress.Sql/StswExpress.Sql.csproj"
          ]
        }
      ],
      "dest": "api/core",
      "properties": {
        "TargetFramework": "net8.0"
      }
    },
    {
      "src": [
        {
          "src": "..",
          "files": [
            "StswExpress.Wpf/StswExpress.Wpf.csproj",
            "StswExpress.Wpf.Themes/StswExpress.Wpf.Themes.csproj"
          ]
        }
      ],
      "dest": "api/wpf"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "screenshots/**",
          "assets/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "globalMetadata": {
      "_appName": "StswExpress",
      "_appTitle": "StswExpress Documentation",
      "_appLogoPath": "assets/images/logo-docs.png",
      "_appFooter": "StswExpress documentation · MIT License",
      "_enableSearch": true,
      "_enableNewTab": true
    },
    "sitemap": {
      "baseUrl": "https://stsw133.github.io/StswExpress/",
      "changefreq": "weekly",
      "priority": 0.5
    }
  }
}