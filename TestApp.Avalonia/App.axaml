<se:StswApp x:Class="TestApp.Ava.App"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:se="using:StswExpress.Avalonia">
	<se:StswApp.Styles>
		<StyleInclude Source="avares://StswExpress.Avalonia/Controls/StswControls.axaml"/>
	</se:StswApp.Styles>
	<Application.Resources>
		<se:StswResources CurrentTheme="Dark"/>
	</Application.Resources>
</se:StswApp>