<Window x:Class="TestApp.Ava.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:StswExpress.Avalonia;assembly=StswExpress.Avalonia"
        xmlns:local="clr-namespace:TestApp.Ava"
        Height="600" Width="1000" WindowStartupLocation="CenterScreen"
        Title="Test" Icon="/Assets/icon.ico"
	    x:DataType="local:MainContext">
	
    <StackPanel>
		<se:StswIcon Data="{x:Static se:StswIcons.Seal}" Margin="5" Scale="2.5"/>
		<se:StswSeparator/>
		<se:StswButton Command="{Binding IncrementCountCommand}" Content="TEST" Margin="5"/>
        <se:StswText FontSize="20" HorizontalAlignment="Center" Text="{Binding CountText}"/>
        <local:StswIconView/>
    </StackPanel>
</Window>
