<Window x:Class="TestApp.Ava.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="clr-namespace:StswExpress.Avalonia;assembly=StswExpress.Avalonia"
        xmlns:local="clr-namespace:TestApp.Ava"
		x:DataType="local:MainContext"
        Height="600" Width="1000" WindowStartupLocation="CenterScreen"
        Title="Test" Icon="/Assets/icon.ico">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
		<se:StswIcon Data="{x:Static se:StswIcons.Seal}"/>
		<TextBlock Text="TEST" IsVisible="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}}, Converter={x:Static se:StswBoolConverter.Instance}, ConverterParameter='!'}"/>
		<se:StswButton Content="TEST" Click="IncrementCount"/>
        <TextBlock FontSize="20" HorizontalAlignment="Center" Text="{Binding CountText}"/>
    </StackPanel>
</Window>
