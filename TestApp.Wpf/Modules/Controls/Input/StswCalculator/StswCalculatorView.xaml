<UserControl x:Class="TestApp.Wpf.StswCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:se="clr-namespace:StswExpress.Wpf;assembly=StswExpress.Wpf"
             xmlns:local="clr-namespace:TestApp.Wpf"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:StswCalculatorContext}">

    <local:ControlsBase>
        <!-- properties -->
        
        <!-- content -->
        <se:StswCalculator DisplayText="{Binding DisplayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           ExpressionText="{Binding ExpressionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           IsEnabled="{Binding IsEnabled}"
                           HorizontalAlignment="{Binding HorizontalAlignment}"
                           HorizontalContentAlignment="{Binding HorizontalContentAlignment}"
                           VerticalAlignment="{Binding VerticalAlignment}"
                           VerticalContentAlignment="{Binding VerticalContentAlignment}"/>
        <!-- status panel -->

    </local:ControlsBase>
</UserControl>
