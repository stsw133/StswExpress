<UserControl x:Class="TestApp.Wpf.StswInputBoxTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:se="clr-namespace:StswExpress.Wpf;assembly=StswExpress.Wpf"
             xmlns:local="clr-namespace:TestApp.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:StswInputBoxTestContext}">
    <local:ControlsBase x:Name="InputBoxHost" IsContentAlignmentVisible="True">
        <!-- properties -->
        <local:ControlsBase.Properties>
            <!-- Icon -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf Icon, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding Icon}"/>
            <!-- SubControls -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf SubControls, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding SubControls}"/>
            <!-- IsReadOnly -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf IsReadOnly, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding IsReadOnly}"/>
            <!-- AcceptsReturn -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf AcceptsReturn, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding AcceptsReturn}"/>
            <!-- AcceptsTab -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf AcceptsTab, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding AcceptsTab}"/>
            <!-- TextWrapping -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf TextWrapping, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswComboBox ItemsSource="{se:StswEnumToList TextWrapping}" Margin="0 0 0 3" SelectedValue="{Binding TextWrapping}"/>
            <!-- HorizontalScrollBarVisibility -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf HorizontalScrollBarVisibility, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswComboBox ItemsSource="{se:StswEnumToList ScrollBarVisibility}" Margin="0 0 0 3" SelectedValue="{Binding HorizontalScrollBarVisibility}"/>
            <!-- VerticalScrollBarVisibility -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf VerticalScrollBarVisibility, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswComboBox ItemsSource="{se:StswEnumToList ScrollBarVisibility}" Margin="0 0 0 3" SelectedValue="{Binding VerticalScrollBarVisibility}"/>
            <!-- MinLines -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf MinLines, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswIntegerBox Minimum="1" Margin="0 0 0 3" Value="{Binding MinLines}"/>
            <!-- MaxLines -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf MaxLines, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswIntegerBox Minimum="0" Margin="0 0 0 3" Value="{Binding MaxLines}"/>
            <!-- CharacterCasing -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf CharacterCasing, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswComboBox ItemsSource="{se:StswEnumToList CharacterCasing}" Margin="0 0 0 3" SelectedValue="{Binding CharacterCasing}"/>
            <!-- IsTextDragDropEnabled -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf IsTextDragDropEnabled, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding IsTextDragDropEnabled}"/>
            <!-- IsInactiveSelectionHighlightEnabled -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf IsInactiveSelectionHighlightEnabled, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding IsInactiveSelectionHighlightEnabled}"/>
            <!-- FlowDirection -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf FlowDirection, Type={x:Type se:StswInputBoxTest}}"/>
            <se:StswComboBox ItemsSource="{se:StswEnumToList FlowDirection}" Margin="0 0 0 3" SelectedValue="{Binding FlowDirection}"/>
        </local:ControlsBase.Properties>

        <!-- content -->
        <se:StswInputBoxTest Margin="5"
                             IsEnabled="{Binding IsEnabled}"
                             Text="{Binding Text, Mode=TwoWay}"
                             IsReadOnly="{Binding IsReadOnly}"
                             AcceptsReturn="{Binding AcceptsReturn}"
                             AcceptsTab="{Binding AcceptsTab}"
                             TextWrapping="{Binding TextWrapping}"
                             HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility}"
                             VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility}"
                             MinLines="{Binding MinLines}"
                             MaxLines="{Binding MaxLines}"
                             CharacterCasing="{Binding CharacterCasing}"
                             IsTextDragDropEnabled="{Binding IsTextDragDropEnabled}"
                             IsInactiveSelectionHighlightEnabled="{Binding IsInactiveSelectionHighlightEnabled}"
                             HorizontalAlignment="{Binding HorizontalAlignment}"
                             HorizontalContentAlignment="{Binding HorizontalContentAlignment}"
                             VerticalAlignment="{Binding VerticalAlignment}"
                             VerticalContentAlignment="{Binding VerticalContentAlignment}"
                             FlowDirection="{Binding FlowDirection}"
                             Placeholder="Enter the text...">
            <se:StswInputBoxTest.Icon>
                <se:StswIcon Data="{x:Static se:StswIcons.Account}" Margin="5 0 0 0" Visibility="{Binding Icon}"/>
            </se:StswInputBoxTest.Icon>
            <se:StswInputBoxTest.SubControls>
                <se:StswSubButton Command="{Binding SetUnicodeCommand}" IconData="{x:Static se:StswIcons.DiceMultiple}" Visibility="{Binding SubControls}"/>
                <se:StswSubButton Command="{x:Static se:StswCommands.ClearText}" IconData="{x:Static se:StswIcons.Close}" Visibility="{Binding SubControls}"/>
            </se:StswInputBoxTest.SubControls>
        </se:StswInputBoxTest>

        <!-- status panel -->
        <local:ControlsBase.StatusPanel>
            <StackPanel>
                <WrapPanel Margin="0 0 0 5">
                    <se:StswButton Command="{Binding SetShortSingleLineCommand}" Content="Short" Margin="0 0 5 5" Padding="8 4"/>
                    <se:StswButton Command="{Binding SetLongSingleLineCommand}" Content="Long line" Margin="0 0 5 5" Padding="8 4"/>
                    <se:StswButton Command="{Binding SetMultilineWithEmptyLinesCommand}" Content="Empty lines" Margin="0 0 5 5" Padding="8 4"/>
                    <se:StswButton Command="{Binding SetMultilineWithLongLinesCommand}" Content="Long multiline" Margin="0 0 5 5" Padding="8 4"/>
                    <se:StswButton Command="{Binding SetUnicodeCommand}" Content="Unicode" Margin="0 0 5 5" Padding="8 4"/>
                    <se:StswButton Command="{Binding SetRtlCommand}" Content="RTL" Margin="0 0 5 5" Padding="8 4"/>
                </WrapPanel>
                <se:StswSeparator BorderThickness="1" Margin="5"/>
                <se:StswText FontWeight="Medium" HorizontalAlignment="Center" Text="Scroll diagnostics"/>
                <StackPanel>
                    <se:StswText Padding="5" TextWrapping="Wrap"><Run Text="Caret: "/><Run FontWeight="Bold" Text="{Binding Content.CaretIndex, ElementName=InputBoxHost}"/><Run Text="   Selection: "/><Run FontWeight="Bold" Text="{Binding Content.SelectionStart, ElementName=InputBoxHost}"/><Run Text=" + "/><Run FontWeight="Bold" Text="{Binding Content.SelectionLength, ElementName=InputBoxHost}"/><Run Text="   Lines: "/><Run FontWeight="Bold" Text="{Binding Content.LineCount, ElementName=InputBoxHost}"/></se:StswText>
                    <se:StswText Padding="5" TextWrapping="Wrap"><Run Text="Offset H/V: "/><Run FontWeight="Bold" Text="{Binding Content.HorizontalOffset, ElementName=InputBoxHost, StringFormat=F1}"/><Run Text=" / "/><Run FontWeight="Bold" Text="{Binding Content.VerticalOffset, ElementName=InputBoxHost, StringFormat=F1}"/><Run Text="   Viewport W/H: "/><Run FontWeight="Bold" Text="{Binding Content.ViewportWidth, ElementName=InputBoxHost, StringFormat=F1}"/><Run Text=" / "/><Run FontWeight="Bold" Text="{Binding Content.ViewportHeight, ElementName=InputBoxHost, StringFormat=F1}"/></se:StswText>
                    <se:StswText Padding="5" TextWrapping="Wrap"><Run Text="Extent W/H: "/><Run FontWeight="Bold" Text="{Binding Content.ExtentWidth, ElementName=InputBoxHost, StringFormat=F1}"/><Run Text=" / "/><Run FontWeight="Bold" Text="{Binding Content.ExtentHeight, ElementName=InputBoxHost, StringFormat=F1}"/><Run Text="   Scrollable W/H: "/><Run FontWeight="Bold" Text="{Binding Content.ScrollableWidth, ElementName=InputBoxHost, StringFormat=F1}"/><Run Text=" / "/><Run FontWeight="Bold" Text="{Binding Content.ScrollableHeight, ElementName=InputBoxHost, StringFormat=F1}"/></se:StswText>
                </StackPanel>
            </StackPanel>
        </local:ControlsBase.StatusPanel>
    </local:ControlsBase>
</UserControl>
