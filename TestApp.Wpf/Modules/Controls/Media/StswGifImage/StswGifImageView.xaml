<UserControl x:Class="TestApp.Wpf.StswGifImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:se="clr-namespace:StswExpress.Wpf;assembly=StswExpress.Wpf"
             xmlns:local="clr-namespace:TestApp.Wpf"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:StswGifImageContext}">

    <local:ControlsBase IsContentAlignmentVisible="False">
        <local:ControlsBase.Description>
            Represents a control to display GIF images with support for animation.
        </local:ControlsBase.Description>
        <!-- properties -->
        <local:ControlsBase.Properties>
            <!-- Source -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf Source, Type={x:Type se:StswGifImage}}"/>
            <se:StswPathPicker Filter="GIF (*.gif)|*.gif|All files|*.*" Margin="0 0 0 3" SelectedPath="{Binding Source}"/>
            <!-- Stretch -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf Stretch, Type={x:Type se:StswGifImage}}"/>
            <se:StswComboBox ItemsSource="{se:StswEnumToList Stretch}" Margin="0 0 0 3" SelectedValue="{Binding Stretch}"/>
        </local:ControlsBase.Properties>
        <!-- content -->
        <se:StswGifImage IsEnabled="{Binding IsEnabled}"
                         Source="{Binding Source}"
                         Stretch="{Binding Stretch}"
                         HorizontalAlignment="{Binding HorizontalAlignment}"
                         VerticalAlignment="{Binding VerticalAlignment}"/>
        <!-- status panel -->

    </local:ControlsBase>
</UserControl>
