<UserControl x:Class="TestApp.Wpf.StswComboBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:se="clr-namespace:StswExpress.Wpf;assembly=StswExpress.Wpf"
             xmlns:local="clr-namespace:TestApp.Wpf"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:StswComboBoxContext}">

    <local:ControlsBase>
        <!-- properties -->
        <local:ControlsBase.Properties>
            <!-- ClearFilterOnDropDownOpen -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf ClearFilterOnDropDownOpen, Type={x:Type se:StswComboBox}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding ClearFilterOnDropDownOpen}"/>
            <!-- HideSelectedItemWhenFiltered -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf HideSelectedItemWhenFiltered, Type={x:Type se:StswComboBox}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding HideSelectedItemWhenFiltered}"/>
            <!-- Icon -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf Icon, Type={x:Type se:StswComboBox}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding Icon}"/>
            <!-- IsEditable -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf IsEditable, Type={x:Type se:StswComboBox}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding IsEditable}"/>
            <!-- IsFilterEnabled -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf IsFilterEnabled, Type={x:Type se:StswComboBox}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding IsFilterEnabled}"/>
            <!-- IsReadOnly -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf IsReadOnly, Type={x:Type se:StswComboBox}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding IsReadOnly}"/>
            <!-- SubControls -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf SubControls, Type={x:Type se:StswComboBox}}"/>
            <se:StswToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding SubControls}"/>
            <!-- DropArrow.Visibility -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="DropArrow.Visibility"/>
            <se:StswComboBox ItemsSource="{se:StswEnumToList Visibility}" Margin="0 0 0 3" SelectedValue="{Binding DropArrowVisibility}"/>
        </local:ControlsBase.Properties>
        <!-- content -->
        <se:StswComboBox ClearFilterOnDropDownOpen="{Binding ClearFilterOnDropDownOpen}"
                         HideSelectedItemWhenFiltered="{Binding HideSelectedItemWhenFiltered}"
                         IsEditable="{Binding IsEditable}"
                         IsEnabled="{Binding IsEnabled}"
                         IsFilterEnabled="{Binding IsFilterEnabled}"
                         IsReadOnly="{Binding IsReadOnly}"
                         ItemsSource="{Binding Items}"
                         Placeholder="Select item..."
                         SelectedItem="{Binding SelectedItem}"
                         HorizontalAlignment="{Binding HorizontalAlignment}"
                         HorizontalContentAlignment="{Binding HorizontalContentAlignment}"
                         VerticalAlignment="{Binding VerticalAlignment}"
                         VerticalContentAlignment="{Binding VerticalContentAlignment}"
                         se:StswDropArrow.Visibility="{Binding DropArrowVisibility}">
            <se:StswComboBox.Icon>
                <se:StswIcon Data="{x:Static se:StswIcons.Account}" Margin="5 0 0 0" Visibility="{Binding Icon}"/>
            </se:StswComboBox.Icon>
            <se:StswComboBox.SubControls>
                <se:StswSubButton Command="{Binding RandomizeCommand}" IconData="{x:Static se:StswIcons.DiceMultiple}" Visibility="{Binding SubControls}"/>
                <se:StswSubButton Command="{x:Static se:StswCommands.ClearSelection}" IconData="{x:Static se:StswIcons.Close}" Visibility="{Binding SubControls}"/>
            </se:StswComboBox.SubControls>
        </se:StswComboBox>
        <!-- status panel -->
        <local:ControlsBase.StatusPanel>
            <se:StswText Padding="5">
                <Run Text="{Binding SelectedItem, Mode=OneWay}" FontWeight="Bold"/>
                <Run Text=" is selected"/>
            </se:StswText>
        </local:ControlsBase.StatusPanel>
    </local:ControlsBase>
</UserControl>
