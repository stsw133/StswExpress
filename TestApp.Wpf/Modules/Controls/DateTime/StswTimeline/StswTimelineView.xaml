<UserControl x:Class="TestApp.Wpf.StswTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:se="clr-namespace:StswExpress.Wpf;assembly=StswExpress.Wpf"
             xmlns:local="clr-namespace:TestApp.Wpf"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance local:StswTimelineContext}">

    <local:ControlsBase IsContentAlignmentVisible="True">
        <local:ControlsBase.Description>
            Presents the StswTimeline control which arranges chronological items along a horizontal axis and reveals extra information through hover tooltips.
        </local:ControlsBase.Description>
        <!-- properties -->
        <local:ControlsBase.Properties>
            <!-- Minimum -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf Minimum, Type={x:Type se:StswTimeline}}"/>
            <se:StswDatePicker Margin="0 0 0 3" SelectedDate="{Binding Minimum}"/>
            <!-- Maximum -->
            <se:StswText FontSize="15" FontWeight="Medium" Padding="3" Text="{se:StswNameOf Maximum, Type={x:Type se:StswTimeline}}"/>
            <se:StswDatePicker Margin="0 0 0 3" SelectedDate="{Binding Maximum}"/>
            <!-- Commands -->
            <UniformGrid Margin="0 6 0 0" Rows="1">
                <se:StswButton Content="Auto range" Command="{Binding ApplyNaturalRangeCommand}" Margin="0 0 6 0"/>
                <se:StswButton Content="Clear range" Command="{Binding ClearRangeCommand}"/>
            </UniformGrid>
        </local:ControlsBase.Properties>
        <!-- content -->
        <se:StswTimeline DateMemberPath="Date"
                         IsEnabled="{Binding IsEnabled}"
                         ItemsSource="{Binding Milestones}"
                         Minimum="{Binding Minimum}"
                         Maximum="{Binding Maximum}"
                         HorizontalAlignment="{Binding HorizontalAlignment}"
                         HorizontalContentAlignment="{Binding HorizontalContentAlignment}"
                         VerticalAlignment="{Binding VerticalAlignment}"
                         VerticalContentAlignment="{Binding VerticalContentAlignment}">
            <se:StswTimeline.ItemPopupTemplate>
                <DataTemplate>
                    <se:StswText>
                        <Run Text="{Binding Date, StringFormat=yyyy-MM-dd, Mode=OneWay}" FontSize="11"/>
                        <LineBreak/>
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="{Binding Summary, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="{Binding Details, Mode=OneWay}"/>
                    </se:StswText>
                </DataTemplate>
            </se:StswTimeline.ItemPopupTemplate>
        </se:StswTimeline>
        <!-- status panel -->
        
    </local:ControlsBase>
</UserControl>
