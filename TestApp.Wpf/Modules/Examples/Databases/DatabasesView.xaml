<UserControl x:Class="TestApp.Wpf.DatabasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:se="clr-namespace:StswExpress.Wpf;assembly=StswExpress.Wpf"
             xmlns:local="clr-namespace:TestApp.Wpf" d:DataContext="{d:DesignInstance local:DatabasesContext}"
             mc:Ignorable="d" d:Background="White" d:DesignHeight="450" d:DesignWidth="750">

    <DockPanel>
        <DockPanel>
            <!-- button panel -->
            <se:StswDirectionView DockPanel.Dock="Top" Orientation="Horizontal" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <se:StswSubButton Command="{Binding MoveUpCommand}"
                                      IconData="{x:Static se:StswIcons.ArrowUp}"
                                      IconScale="1.5"
                                      se:StswToolTip.Text="Move selected database up"/>
                    <se:StswSubButton Command="{Binding MoveDownCommand}"
                                      IconData="{x:Static se:StswIcons.ArrowDown}"
                                      IconScale="1.5"
                                      se:StswToolTip.Text="Move selected database down"/>
                    <se:StswSubButton Command="{Binding AddCommand}"
                                      IconData="{x:Static se:StswIcons.Plus}"
                                      IconFill="{DynamicResource StswColor.Positive}"
                                      IconScale="1.5"
                                      se:StswToolTip.Text="Add new database"/>
                    <se:StswSubButton Command="{Binding RemoveCommand}"
                                      IconData="{x:Static se:StswIcons.Minus}"
                                      IconFill="{DynamicResource StswColor.Negative}"
                                      IconScale="1.5"
                                      se:StswToolTip.Text="Remove selected database"/>
                    <se:StswSubButton Command="{Binding ImportCommand}"
                                      IconData="{x:Static se:StswIcons.Refresh}"
                                      IconFill="{DynamicResource StswColor.Neutral}"
                                      IconScale="1.5"
                                      se:StswToolTip.Text="Import list of databases"/>
                    <se:StswSubButton Command="{Binding ExportCommand}"
                                      IconData="{x:Static se:StswIcons.DatabaseExportOutline}"
                                      IconFill="{DynamicResource StswColor.Modify}"
                                      IconScale="1.5"
                                      se:StswToolTip.Text="Export list of databases"/>
                </StackPanel>
            </se:StswDirectionView>
            <!-- list -->
            <se:StswListBox BorderThickness="0 1 0 0" DisplayMemberPath="Name" ItemsSource="{Binding AllDatabases}" SelectedItem="{Binding SelectedDatabase}"/>
        </DockPanel>
        <se:StswSeparator BorderThickness="1" Orientation="Vertical"/>

        <!-- selected database model -->
        <se:StswScrollView IsEnabled="{Binding SelectedDatabase, Converter={x:Static se:StswExistenceConverter.Instance}}">
			<Grid Margin="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MinWidth="200"/>
				</Grid.ColumnDefinitions>

				<!-- database model -->
				<StackPanel Grid.Column="0" Margin="3">
					<se:StswText FontSize="16" FontWeight="SemiBold" Margin="3 3 3 10" Text="Database settings"/>

					<!-- name -->
					<StackPanel Margin="3">
						<se:StswLabel Content="Name:"/>
						<se:StswTextBox Text="{Binding SelectedDatabase.Name}"/>
					</StackPanel>

					<!-- server -->
					<StackPanel Margin="3">
						<se:StswLabel Content="Server:"/>
						<se:StswTextBox Text="{Binding SelectedDatabase.Server}"/>
					</StackPanel>

					<!-- port -->
					<StackPanel Margin="3">
						<se:StswLabel Content="Port:"/>
						<se:StswIntegerBox Value="{Binding SelectedDatabase.Port}"/>
					</StackPanel>

					<!-- database -->
					<StackPanel Margin="3">
						<se:StswLabel Content="Database:"/>
						<se:StswTextBox Text="{Binding SelectedDatabase.Database}"/>
					</StackPanel>

					<!-- use integrated security -->
					<se:StswCheckBox Content="Use integrated security" IsChecked="{Binding SelectedDatabase.UseIntegratedSecurity}" Margin="3 10 3 0"/>

					<!-- login -->
					<StackPanel Margin="3" IsEnabled="{Binding SelectedDatabase.UseIntegratedSecurity, Converter={x:Static se:StswBoolConverter.Instance}, ConverterParameter=!}">
						<se:StswLabel Content="Login:"/>
						<se:StswTextBox Text="{Binding SelectedDatabase.Login}"/>
					</StackPanel>

					<!-- password -->
					<StackPanel Margin="3" IsEnabled="{Binding SelectedDatabase.UseIntegratedSecurity, Converter={x:Static se:StswBoolConverter.Instance}, ConverterParameter=!}">
						<se:StswLabel Content="Password:"/>
						<se:StswPasswordBox Password="{Binding SelectedDatabase.Password}">
							<se:StswPasswordBox.SubControls>
								<se:StswSubCheck Focusable="False" IconUnchecked="{x:Static se:StswIcons.Eye}" IconChecked="{x:Static se:StswIcons.EyeOff}" Margin="0 0 3 0"
                                                 IsChecked="{Binding ShowPassword, RelativeSource={RelativeSource AncestorType={x:Type se:StswPasswordBox}}}"/>
							</se:StswPasswordBox.SubControls>
						</se:StswPasswordBox>
					</StackPanel>
				</StackPanel>

			</Grid>
		</se:StswScrollView>
    </DockPanel>
</UserControl>
