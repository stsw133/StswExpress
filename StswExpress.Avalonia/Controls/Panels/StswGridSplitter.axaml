<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="using:StswExpress.Avalonia">

	<Style Selector="se|StswGridSplitter">
		<Setter Property="Background" Value="{DynamicResource StswExpander.Static.Header}"/>

		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>

		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="VerticalAlignment" Value="Stretch"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="se:StswGridSplitter">
					<Border x:Name="OPT_MainShape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</Styles>