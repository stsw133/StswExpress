<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="using:StswExpress.Avalonia">

	<Style Selector="se|StswText">
		<Setter Property="Foreground" Value="{DynamicResource StswText.Static.Foreground}"/>
	</Style>

	<Style Selector="se|StswText:disabled">
		<Setter Property="Opacity" Value="0.4"/>
		<Setter Property="Foreground" Value="{DynamicResource StswText.Disabled.Foreground}"/>
	</Style>
</Styles>