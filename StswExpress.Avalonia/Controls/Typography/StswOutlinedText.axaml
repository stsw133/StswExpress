<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="using:StswExpress.Avalonia">

    <Style Selector="se|StswOutlinedText">
		<Setter Property="Fill" Value="{DynamicResource StswText.Static.Foreground}"/>
		<Setter Property="Stroke" Value="{DynamicResource StswText.Static.Foreground}"/>
		<Setter Property="StrokeThickness" Value="1"/>
    </Style>

	<Style Selector="se|StswOutlinedText:disabled">
		<Setter Property="Opacity" Value="0.4"/>
		<Setter Property="Fill" Value="{DynamicResource StswText.Disabled.Foreground}"/>
		<Setter Property="Stroke" Value="{DynamicResource StswText.Disabled.Foreground}"/>
	</Style>
    
</Styles>