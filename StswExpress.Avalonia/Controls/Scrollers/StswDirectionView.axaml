<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:se="using:StswExpress.Avalonia">

	<Style Selector="se|StswDirectionView">
		<Setter Property="BBtnThickness" Value="2"/>
		<Setter Property="FBtnThickness" Value="2"/>
		<Setter Property="DynamicMode" Value="Off"/>

		<Setter Property="Focusable" Value="True"/>
		<Setter Property="IsTabStop" Value="False"/>

		<Setter Property="Orientation" Value="Horizontal"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="VerticalAlignment" Value="Stretch"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="se:StswDirectionView">
					<Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,*,Auto" Background="{TemplateBinding Background}">
						<ScrollContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1" Grid.Row="1"
												Content="{TemplateBinding Content}"
												ContentTemplate="{TemplateBinding ContentTemplate}"
												Padding="{TemplateBinding Padding}"/>

						<se:StswRepeatButton x:Name="PART_ButtonDown" Grid.Column="1" Grid.Row="2"
											 BorderThickness="{TemplateBinding FBtnThickness}"
											 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<se:StswIcon Data="{x:Static se:StswIcons.MenuDown}"/>
						</se:StswRepeatButton>
						<se:StswRepeatButton x:Name="PART_ButtonLeft" Grid.Column="0" Grid.Row="1"
											 BorderThickness="{TemplateBinding BBtnThickness}"
											 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<se:StswIcon Data="{x:Static se:StswIcons.MenuLeft}"/>
						</se:StswRepeatButton>
						<se:StswRepeatButton x:Name="PART_ButtonRight" Grid.Column="2" Grid.Row="1"
											 BorderThickness="{TemplateBinding FBtnThickness}"
											 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<se:StswIcon Data="{x:Static se:StswIcons.MenuRight}"/>
						</se:StswRepeatButton>
						<se:StswRepeatButton x:Name="PART_ButtonUp" Grid.Column="1" Grid.Row="0"
											 BorderThickness="{TemplateBinding BBtnThickness}"
											 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<se:StswIcon Data="{x:Static se:StswIcons.MenuUp}"/>
						</se:StswRepeatButton>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style Selector="se|StswDirectionView:dynamic-partial /template/ se|StswRepeatButton">
		<Setter Property="Opacity" Value="0.55"/>
	</Style>

	<Style Selector="se|StswDirectionView:dynamic-full /template/ se|StswRepeatButton">
		<Setter Property="Opacity" Value="0"/>
		<Setter Property="IsHitTestVisible" Value="False"/>
	</Style>

	<Style Selector="se|StswDirectionView:dynamic-full:pointerover /template/ se|StswRepeatButton">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="IsHitTestVisible" Value="True"/>
	</Style>
	
	<Style Selector="se|StswDirectionView[Orientation=Horizontal] /template/ se|StswRepeatButton#PART_ButtonUp">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
	<Style Selector="se|StswDirectionView[Orientation=Horizontal] /template/ se|StswRepeatButton#PART_ButtonDown">
		<Setter Property="IsVisible" Value="False"/>
	</Style>

	<Style Selector="se|StswDirectionView[Orientation=Vertical] /template/ se|StswRepeatButton#PART_ButtonLeft">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
	<Style Selector="se|StswDirectionView[Orientation=Vertical] /template/ se|StswRepeatButton#PART_ButtonRight">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
	
	<Style Selector="se|StswDirectionView:pointerover:dynamic-full /template/ se|StswRepeatButton">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="IsHitTestVisible" Value="True"/>
	</Style>
</Styles>
