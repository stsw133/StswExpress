<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:se="clr-namespace:StswExpress.Wpf">

    <Style TargetType="{x:Type se:StswHoldButton}">
        <Setter Property="Background" Value="{DynamicResource StswButton.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StswButton.Static.Border}"/>

        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="10"/>

        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>

        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="se:StswControl.EnableRippleEffect" Value="False"/>
        <Setter Property="se:StswFocusVisual.Assign" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswHoldButton}">
                    <!-- main -->
                    <Grid x:Name="OPT_Root">
                        <Ellipse x:Name="OPT_MainEllipse"
                                 Fill="{TemplateBinding Background}"
                                 MinHeight="{Binding ActualHeight, ElementName=OPT_ContentHost}"
                                 MinWidth="{Binding ActualWidth, ElementName=OPT_ContentHost}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="{TemplateBinding BorderThickness}"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <se:StswProgressRing x:Name="OPT_ProgressRing"
                                             Background="Transparent"
                                             BorderBrush="Transparent"
                                             Fill="{DynamicResource StswColor.Negative}"
                                             IsHitTestVisible="False"
                                             Minimum="0" Maximum="1"
                                             Scale="{x:Null}"
                                             State="Custom"
                                             TextMode="None"
                                             Value="{TemplateBinding HoldProgress}"
                                             Height="{Binding ActualHeight, ElementName=OPT_MainEllipse}"
                                             Width="{Binding ActualHeight, ElementName=OPT_MainEllipse}"/>
                        <Border x:Name="OPT_ContentHost"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ContentPresenter x:Name="OPT_ContentPresenter"
                                              Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <!-- triggers -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource StswButton.MouseOver.Background}" TargetName="OPT_MainEllipse"/>
                            <Setter Property="Stroke" Value="{DynamicResource StswButton.MouseOver.Border}" TargetName="OPT_MainEllipse"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource StswButton.Pressed.Background}" TargetName="OPT_MainEllipse"/>
                            <Setter Property="Stroke" Value="{DynamicResource StswButton.Pressed.Border}" TargetName="OPT_MainEllipse"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Fill" Value="{DynamicResource StswButton.Disabled.Background}" TargetName="OPT_MainEllipse"/>
                            <Setter Property="Stroke" Value="{DynamicResource StswButton.Disabled.Border}" TargetName="OPT_MainEllipse"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource StswButton.Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>