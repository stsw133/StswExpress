<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:se="clr-namespace:StswExpress.Wpf">

    <Style TargetType="{x:Type se:StswCalculator}">
        <Setter Property="Background" Value="{DynamicResource StswBox.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StswBox.Static.Border}"/>

        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerClipping" Value="True"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="6"/>

        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>

        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswCalculator}">
                    <!-- main -->
                    <se:StswBorder x:Name="PART_MainBorder"
                                   Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerClipping="{TemplateBinding CornerClipping}"
                                   CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- screen -->
                            <Border Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource StswBox.Static.Background}"
                                    BorderBrush="{DynamicResource StswBox.Static.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <se:StswText Grid.Row="0"
                                                 FontSize="14"
                                                 Foreground="{DynamicResource StswText.Placeholder.Foreground}"
                                                 HorizontalAlignment="Right"
                                                 Text="{TemplateBinding ExpressionText}"/>
                                    <TextBox Grid.Row="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="24"
                                             Foreground="{DynamicResource StswText.Static.Foreground}"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="False"
                                             Text="{TemplateBinding DisplayText}"
                                             HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- buttons -->
                            <Grid Grid.Row="1" Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- First row -->
                                <se:StswButton Grid.Row="0" Grid.Column="0" Margin="3" Content="C" Command="{Binding ClearCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <se:StswButton Grid.Row="0" Grid.Column="1" Margin="3" Content="⌫" Command="{Binding BackspaceCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <se:StswButton Grid.Row="0" Grid.Column="2" Margin="3" Content="÷" Command="{Binding OperatorCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="÷"/>
                                <se:StswButton Grid.Row="0" Grid.Column="3" Margin="3" Content="×" Command="{Binding OperatorCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="×"/>
                                <!-- Second row -->
                                <se:StswButton Grid.Row="1" Grid.Column="0" Margin="3" Content="7" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="7"/>
                                <se:StswButton Grid.Row="1" Grid.Column="1" Margin="3" Content="8" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="8"/>
                                <se:StswButton Grid.Row="1" Grid.Column="2" Margin="3" Content="9" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="9"/>
                                <se:StswButton Grid.Row="1" Grid.Column="3" Margin="3" Content="−" Command="{Binding OperatorCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="−"/>
                                <!-- Third row -->
                                <se:StswButton Grid.Row="2" Grid.Column="0" Margin="3" Content="4" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="4"/>
                                <se:StswButton Grid.Row="2" Grid.Column="1" Margin="3" Content="5" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="5"/>
                                <se:StswButton Grid.Row="2" Grid.Column="2" Margin="3" Content="6" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="6"/>
                                <se:StswButton Grid.Row="2" Grid.Column="3" Margin="3" Content="+" Command="{Binding OperatorCommand, RelativeSource={RelativeSource TemplatedParent}}"  CommandParameter="+"/>
                                <!-- Fourth row -->
                                <se:StswButton Grid.Row="3" Grid.Column="0" Margin="3" Content="1" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="1"/>
                                <se:StswButton Grid.Row="3" Grid.Column="1" Margin="3" Content="2" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="2"/>
                                <se:StswButton Grid.Row="3" Grid.Column="2" Margin="3" Content="3" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="3"/>
                                <se:StswButton Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Margin="3" Content="=" Command="{Binding EqualsCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <!-- Fifth row -->
                                <se:StswButton Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="3" Content="0" Command="{Binding DigitCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="0"/>
                                <se:StswButton Grid.Row="4" Grid.Column="2" Margin="3" Content="." Command="{Binding DecimalSeparatorCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Grid>
                    </se:StswBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>