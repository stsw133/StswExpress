<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:se="clr-namespace:StswExpress.Wpf">

    <Style TargetType="{x:Type se:StswFileDialog}">
        <Setter Property="BorderThickness" Value="4"/>
        <Setter Property="CornerClipping" Value="True"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="6"/>

        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>

        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswFileDialog}">
                    <!-- main -->
                    <se:StswGroupBox x:Name="OPT_MainBorder"
                                     Background="{TemplateBinding Background}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     CornerClipping="{TemplateBinding CornerClipping}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Focusable="False"
                                     MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type se:StswContentDialog}}, Converter={x:Static se:StswCalculateConverter.Instance}, ConverterParameter=*0.8}"
                                     MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type se:StswContentDialog}}, Converter={x:Static se:StswCalculateConverter.Instance}, ConverterParameter=*0.8}"
                                     MinHeight="300"
                                     MinWidth="500"
                                     Padding="0">
                        <se:StswGroupBox.Header>
                            <DockPanel>
                                <!-- close button -->
                                <se:StswSubButton DockPanel.Dock="Right"
                                                  Command="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                  IconData="{x:Static se:StswIcons.CloseBox}"
                                                  IconFill="{DynamicResource StswColor.Negative}"
                                                  IconScale="2"
                                                  Padding="0"
                                                  se:StswToolTip.Text="{se:StswTranslate StswFileDialog.Close}"/>
                                <!-- header -->
                                <se:StswLabel x:Name="OPT_Header" Content="{TemplateBinding Title}" FontWeight="Medium">
                                    <se:StswLabel.LayoutTransform>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                    </se:StswLabel.LayoutTransform>
                                </se:StswLabel>
                            </DockPanel>
                        </se:StswGroupBox.Header>

                        <DockPanel Background="{DynamicResource StswPanel.Static.Background}">
                            <!-- buttons -->
                            <UniformGrid DockPanel.Dock="Bottom"
                                         HorizontalAlignment="Center"
                                         Margin="{TemplateBinding Padding}"
                                         Rows="1">
                                <se:StswButton Command="{Binding AcceptCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                               IsEnabled="{Binding SelectedPath, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static se:StswExistenceConverter.Instance}, ConverterParameter='!null'}"
                                               Margin="{TemplateBinding Padding}"
                                               MinWidth="100">
                                    <se:StswLabel Content="{se:StswTranslate StswFileDialog.Accept}" IconData="{x:Static se:StswIcons.Check}"/>
                                </se:StswButton>
                                <se:StswButton Command="{Binding CancelCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                               IsEnabled="{Binding SelectedPath, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static se:StswExistenceConverter.Instance}, ConverterParameter='!null'}"
                                               Margin="{TemplateBinding Padding}"
                                               MinWidth="100">
                                    <se:StswLabel Content="{se:StswTranslate StswFileDialog.Cancel}" IconData="{x:Static se:StswIcons.Cancel}" IconFill="{DynamicResource StswColor.Negative}"/>
                                </se:StswButton>
                            </UniformGrid>
                            <!-- separator -->
                            <se:StswSeparator x:Name="OPT_Separator"
                                              DockPanel.Dock="Bottom"
                                              BorderBrush="{Binding BorderBrush, ElementName=OPT_MainBorder}"
                                              BorderThickness="1"
                                              Orientation="Horizontal"/>
                            <!-- content -->
                            <se:StswPathTree Filter="{TemplateBinding Filter}"
                                             InitialPath="{TemplateBinding InitialPath}"
                                             Margin="{TemplateBinding Padding}"
                                             SelectedPath="{Binding SelectedPath, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                             ShowFiles="{TemplateBinding ShowFiles}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"/>
                        </DockPanel>
                    </se:StswGroupBox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>