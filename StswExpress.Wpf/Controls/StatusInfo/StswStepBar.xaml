<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:se="clr-namespace:StswExpress.Wpf">

    <Style TargetType="{x:Type se:StswStepBar}">
        <Setter Property="Background" Value="{DynamicResource StswStepBar.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource StswStepBar.Foreground}"/>
        
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        
        <Setter Property="MinHeight" Value="{Binding StepsSize, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswStepBar}">
                    <Canvas x:Name="PART_Canvas" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>


