<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:se="clr-namespace:StswExpress.Wpf">

    <Style TargetType="{x:Type se:StswStepBarItem}">
        <Setter Property="CompletedColor" Value="{DynamicResource StswStepBar.CompletedColor}"/>
        <Setter Property="UncompletedColor" Value="{DynamicResource StswStepBar.UncompletedColor}"/>
        
        <Setter Property="Height" Value="{Binding StepsSize, RelativeSource={RelativeSource AncestorType={x:Type se:StswStepBar}}}"/>
        <Setter Property="Width" Value="{Binding StepsSize, RelativeSource={RelativeSource AncestorType={x:Type se:StswStepBar}}}"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswStepBarItem}">
                    <Grid>
                        <se:StswBorder x:Name="PART_Border"
                                       BorderBrush="{Binding UncompletedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static se:StswColorConverter.Instance}}"
                                       CornerClipping="True"
                                       CornerRadius="{TemplateBinding Height, Converter={x:Static se:StswCalculateConverter.Instance}, ConverterParameter=/2}"
                                       Height="{TemplateBinding Height}"
                                       Width="{TemplateBinding Width}">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop x:Name="PART_GradientStopStart" Offset="0.0"/>
                                    <GradientStop x:Name="PART_GradientStop1" Offset="0.0"/>
                                    <GradientStop x:Name="PART_GradientStop2" Offset="0.0"/>
                                    <GradientStop x:Name="PART_GradientStopEnd" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid>
                                <se:StswText Text="{Binding StepNumber, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                             Foreground="{Binding CompletedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static se:StswColorConverter.Instance}}"
                                             FontSize="24"
                                             FontWeight="SemiBold"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                <se:StswIcon x:Name="PART_Icon" Data="{x:Static se:StswIcons.CheckBold}"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                             Scale="2"/>
                            </Grid>
                        </se:StswBorder>
                        <se:StswBorder x:Name="PART_ColorBorder"
                                       BorderBrush="{Binding CompletedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static se:StswColorConverter.Instance}}"
                                       CornerRadius="{TemplateBinding Height, Converter={x:Static se:StswCalculateConverter.Instance}, ConverterParameter=*1}"
                                       Opacity="0"
                                       Width="{TemplateBinding Width}"
                                       Height="{TemplateBinding Height}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Statuses">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_GradientStop1"
                                                         Storyboard.TargetProperty="Offset"
                                                         To="0"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_GradientStop2"
                                                         Storyboard.TargetProperty="Offset"
                                                         To="0"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ColorBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_Icon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NextStep">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_GradientStop1"
                                                         Storyboard.TargetProperty="Offset"
                                                         To="0"
                                                         Duration="0:0:0.5"
                                                         BeginTime="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_GradientStop2"
                                                         Storyboard.TargetProperty="Offset"
                                                         To="0"
                                                         Duration="0:0:0.5"
                                                         BeginTime="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ColorBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_Icon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Completed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_GradientStop1"
                                                         Storyboard.TargetProperty="Offset"
                                                         To="1"
                                                         Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_GradientStop2"
                                                         Storyboard.TargetProperty="Offset"
                                                         To="1"
                                                         Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ColorBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_Icon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.3"
                                                         BeginTime="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>


