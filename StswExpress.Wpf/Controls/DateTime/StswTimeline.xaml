<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
                    xmlns:se="clr-namespace:StswExpress.Wpf">

    <Style TargetType="{x:Type se:StswTimeline}">
        <Setter Property="BorderBrush" Value="{DynamicResource StswBorder.Static.Border}"/>
        <Setter Property="BorderThickness" Value="2"/>
        
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Padding" Value="3"/>

        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type se:StswTimeline}">
                    <!-- main -->
                    <Grid Margin="{TemplateBinding Padding}">
                        <Rectangle x:Name="OPT_Line" Fill="{TemplateBinding BorderBrush}" RadiusX="1" RadiusY="1"/>
                        <ItemsPresenter/>
                    </Grid>
                    <!-- triggers -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="OPT_Line"/>
                            <Setter Property="VerticalAlignment" Value="Center" TargetName="OPT_Line"/>
                            <Setter Property="Height" Value="{Binding BorderThickness.Top, RelativeSource={RelativeSource TemplatedParent}}" TargetName="OPT_Line"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="VerticalAlignment" Value="Stretch" TargetName="OPT_Line"/>
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="OPT_Line"/>
                            <Setter Property="Width" Value="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}" TargetName="OPT_Line"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <se:StswTimelinePanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>